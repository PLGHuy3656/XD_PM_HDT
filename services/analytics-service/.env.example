# SwiftletCare Analytics Service Configuration Example
# Copy to .env and customize as appropriate for deployment.

# Service Binding
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8005

# Repository Mode (postgresql or in_memory)
ANALYTICS_REPOSITORY_TYPE=postgresql

# PostgreSQL Persistence
ANALYTICS_DATABASE_URL=postgresql://analytics_user:analytics_password_2026@127.0.0.1:5432/analytics_db

# ETL / Data Pipeline Cross-Service Reader Credentials
ANALYTICS_READER_USER=analytics_reader
ANALYTICS_READER_PASS=analytics_reader_secure_pass_2026
MANAGEMENT_DATABASE_URL=postgresql://analytics_reader:analytics_reader_secure_pass_2026@127.0.0.1:5432/management_db
IOT_DATABASE_URL=postgresql://analytics_reader:analytics_reader_secure_pass_2026@127.0.0.1:5432/iot_db
AI_DATABASE_URL=postgresql://analytics_reader:analytics_reader_secure_pass_2026@127.0.0.1:5432/ai_db
NOTIFICATION_DATABASE_URL=postgresql://analytics_reader:analytics_reader_secure_pass_2026@127.0.0.1:5432/notification_db
