# PostgreSQL URL for the IoT database containing telemetry and devices tables.
DATABASE_URL=postgresql://user:password@localhost:5432/iot_db

# Management Service verifies the bearer token and filters accessible devices.
MANAGEMENT_SERVICE_URL=http://127.0.0.1:8001

# Must match ANALYTICS_SERVICE_TOKEN configured in Management Service.
ANALYTICS_SERVICE_TOKEN=replace-with-a-long-random-service-token

# Required to accept AI pipeline count snapshots.
AI_INGEST_TOKEN=replace-with-a-different-long-random-token

# Leave empty to disable threshold/anomaly event publishing.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENT_EXCHANGE=swiftletcare.events
MONITOR_INTERVAL_SECONDS=30

SERVICE_HOST=127.0.0.1
SERVICE_PORT=8003
