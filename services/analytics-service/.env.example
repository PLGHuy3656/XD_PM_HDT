# Isolated Analytics PostgreSQL database (analytics_db)
ANALYTICS_DATABASE_URL=postgresql://analytics_user:<CHANGE_ME>@localhost:5432/analytics_db
ANALYTICS_REPOSITORY_TYPE=postgresql

# Optional telemetry source mode:
# - analytics_db (default): reads analytics-owned analytics_telemetry_samples table
# - iot_legacy: read-only compatibility mode for shared IoT DB (public.telemetry + public.devices)
ANALYTICS_TELEMETRY_SOURCE=analytics_db

# Management Service (bearer token verification & authorized farm/zone/device lookup)
MANAGEMENT_SERVICE_URL=http://127.0.0.1:8001

# Service-to-service tokens (never commit real secrets)
ANALYTICS_SERVICE_TOKEN=<CHANGE_ME>
AI_INGEST_TOKEN=<CHANGE_ME>

# RabbitMQ domain event publisher (Canonical Domain Event Envelope V1)
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://<RABBITMQ_USER>:<CHANGE_ME>@localhost:5672/
EVENT_EXCHANGE=swiftlet.domain.events
MONITOR_INTERVAL_SECONDS=30

ANALYTICS_SERVICE_HOST=0.0.0.0
ANALYTICS_SERVICE_PORT=8005
