# PostgreSQL URL for the database that contains the users table.
DATABASE_URL=postgresql://postgres:password@localhost:5432/management_db

# Leave empty to run the API without consuming RabbitMQ events.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENT_EXCHANGE=swiftletcare.events
NOTIFICATION_QUEUE=swiftletcare.notifications

# Management Service used to validate access tokens.
MANAGEMENT_SERVICE_URL=http://127.0.0.1:8001

# Optional SMTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true

# Optional Web Push delivery. Configure all three values to enable it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional Firebase Cloud Messaging (Android, iOS, or FCM web clients).
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

SERVICE_HOST=127.0.0.1
SERVICE_PORT=8002
