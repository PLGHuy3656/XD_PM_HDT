# PostgreSQL URL for the isolated notification_db database.
NOTIFICATION_DATABASE_URL=postgresql://notification_user:<CHANGE_ME>@localhost:5432/notification_db

# RabbitMQ connection (either RABBITMQ_URL or RABBITMQ_HOST/PORT/USER/PASSWORD).
# Set RABBITMQ_ENABLED=false (or leave RABBITMQ_URL & RABBITMQ_HOST empty) to disable event consumption.
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://<RABBITMQ_USER>:<CHANGE_ME>@localhost:5672/
EVENT_EXCHANGE=swiftlet.domain.events
NOTIFICATION_QUEUE=swiftletcare.notifications

# Management Service used to validate access tokens and resolve farm recipients.
MANAGEMENT_SERVICE_URL=http://127.0.0.1:8001
INTERNAL_SERVICE_TOKEN=

# Optional SMTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true

# Optional Web Push delivery. Configure all three values to enable it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional Firebase Cloud Messaging (Android, iOS, or FCM web clients).
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=8004
