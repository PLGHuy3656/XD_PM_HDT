# =============================================================================
# SwiftletCare Notification Service — Environment Configuration Example (CP8.3)
# =============================================================================

# Dedicated Notification PostgreSQL Database (CP8.3)
NOTIFICATION_DATABASE_URL=postgresql://notification_user:CHANGE_ME@127.0.0.1:5432/notification_db

# RabbitMQ Consumer Configuration (CP7.4 / CP7.5)
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=swiftlet
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=/
RABBITMQ_NOTIFICATION_QUEUE=notification.alert-events.v1
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_TTL_MS=5000
# CP8.5: deferral while an idempotency lease is held / Redis unavailable, and nack backoff
RABBITMQ_MAX_DEFERS=120
RABBITMQ_NACK_BACKOFF_BASE_MS=500
RABBITMQ_NACK_BACKOFF_MAX_MS=30000

# Redis Message Idempotency Configuration (CP7.5)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
IDEMPOTENCY_TTL_SECONDS=86400
PROCESSING_CLAIM_TTL_SECONDS=60
