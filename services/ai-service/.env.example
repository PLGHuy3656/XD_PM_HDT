# AI Service Configuration (CP8.2)
SERVICE_NAME=ai-service
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8003

# PostgreSQL Durable Persistence (CP8.2 — ai_db)
# Dedicated non-superuser role: ai_user
AI_DATABASE_URL=postgresql://ai_user:CHANGE_ME_AI_PASSWORD@127.0.0.1:5432/ai_db

# Redis Runtime State & Fast Cache (CP8.4)
AI_REDIS_ENABLED=true
AI_REDIS_URL=redis://127.0.0.1:6379/0
AI_LATEST_TTL_SECONDS=3600
AI_RUNTIME_TTL_SECONDS=300

# RabbitMQ Domain Event Producer (CP7.3)
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=swiftlet
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=swiftlet.domain.events
