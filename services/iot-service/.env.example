# IoT Service Configuration
SERVICE_NAME=iot-service
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8002

# MQTT Broker Configuration
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=swiftletcare-iot-service
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_AUTO_START=true

# Device Presence Configuration
DEVICE_STALE_TIMEOUT_SECONDS=90
