# ==============================================================================
# SwiftletCare Local Infrastructure Configuration Template
# Copy to .env and populate with cryptographically secure values.
# NEVER put real credentials in this file or commit .env to version control.
# ==============================================================================

# 1. Core Authentication & Service Mesh
JWT_SECRET=replace_with_secure_random_jwt_secret_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERNAL_SERVICE_TOKEN=replace_with_secure_random_hex_key_64_characters
AI_INTERNAL_SERVICE_KEY=replace_with_secure_random_hex_key_64_characters

# 2. PostgreSQL Demo Cluster (Host port 5433 -> Container 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_random_root_password
POSTGRES_DB=postgres
MANAGEMENT_DB_PASSWORD=replace_with_secure_random_mgmt_password
AI_DB_PASSWORD=replace_with_secure_random_ai_password
NOTIFICATION_DB_PASSWORD=replace_with_secure_random_notification_password
ANALYTICS_DB_PASSWORD=replace_with_secure_random_analytics_password
ANALYTICS_READER_PASSWORD=replace_with_secure_random_analytics_reader_password

# 3. Service Connection URLs (Docker Internal Networking)
DATABASE_URL=postgresql://management_user:${MANAGEMENT_DB_PASSWORD}@postgres-demo:5432/management_db
AI_DATABASE_URL=postgresql://ai_user:${AI_DB_PASSWORD}@postgres-demo:5432/ai_db
NOTIFICATION_DATABASE_URL=postgresql://notification_user:${NOTIFICATION_DB_PASSWORD}@postgres-demo:5432/notification_db
ANALYTICS_DATABASE_URL=postgresql://analytics_user:${ANALYTICS_DB_PASSWORD}@postgres-demo:5432/analytics_db
MANAGEMENT_DATABASE_URL=postgresql://analytics_reader:${ANALYTICS_READER_PASSWORD}@postgres-demo:5432/management_db

# 4. RabbitMQ, Redis & MQTT Infrastructure
RABBITMQ_BIND_IP=127.0.0.1
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=swiftlet
RABBITMQ_DEFAULT_PASS=replace_with_secure_random_rabbitmq_password
RABBITMQ_USER=swiftlet
RABBITMQ_PASSWORD=replace_with_secure_random_rabbitmq_password
RABBITMQ_PREFETCH=10

REDIS_BIND_IP=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_random_redis_password

MQTT_USERNAME=iot_service
MQTT_PASSWORD=replace_with_secure_random_mqtt_password

# 5. Observability
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace_with_secure_random_grafana_password
