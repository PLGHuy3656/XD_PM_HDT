# ==============================================================================
# SwiftletCare Local Infrastructure Configuration Template
# NOTE: Do NOT put real production credentials in this file or commit .env.
# ==============================================================================

# RabbitMQ Infrastructure
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=swiftlet
RABBITMQ_DEFAULT_PASS=swiftlet123

# Service Connection URIs
# Host / local machine access:
# amqp://swiftlet:swiftlet123@localhost:5672/
# Container-to-container access:
# amqp://swiftlet:swiftlet123@rabbitmq:5672/

# Future Consumer Prefetch (Development Default)
RABBITMQ_PREFETCH=10
