# SwiftletCare INT01 Environment Template (Copy to .env.int01 — never commit .env.int01)
ENVIRONMENT=int01

# Host ports (2xxxx block — isolated from Standalone 1xxxx and Demo 3000/8000)
INT01_FRONTEND_PORT=23000
INT01_GATEWAY_PORT=28000
INT01_MANAGEMENT_PORT=28001
INT01_POSTGRES_PORT=25432
INT01_REDIS_PORT=26379
# INT01-R1: IoT (8002) and Mosquitto (1883) are no longer published on the host (internal network only)

# Isolated PostgreSQL & Redis credentials
POSTGRES_USER=swiftlet_int01
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PG_PASSWORD>
POSTGRES_DB=swiftletcare_int01
REDIS_PASSWORD=<CHANGE_ME_STRONG_REDIS_PASSWORD>

# JWT & Internal Service PSK (INTERNAL_SERVICE_TOKEN MUST be >= 32 ASCII bytes)
JWT_SECRET=<CHANGE_ME_32_PLUS_CHAR_JWT_SECRET>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERNAL_SERVICE_TOKEN=<CHANGE_ME_AT_LEAST_32_BYTES_RANDOM_PSK_TOKEN>

# Frontend CORS origin
ALLOWED_ORIGINS=http://localhost:23000,http://127.0.0.1:23000

# Optional ESP32 Simulator device node_id (register this node_id in Management)
INT01_SIMULATOR_DEVICE_ID=SWC-INT01-NODE-01
METADATA_CACHE_TTL_SECONDS=10

# INT01-R1: server-side command ACK deadline (seconds) enforced by the IoT TIMEOUT sweeper
INT01_COMMAND_ACK_TIMEOUT_SECONDS=15
# INT01-R1: simulator fault injection for negative tests ONLY (leave empty for demos)
INT01_SIM_FAULT_MODE=
