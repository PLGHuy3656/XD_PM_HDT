# SwiftletCare Frontend Environment Configuration

# Gateway API Base URL
VITE_API_BASE_URL=http://localhost:8000

# WebSocket Base URL
VITE_WS_BASE_URL=ws://localhost:8000

# Mock Mode: set to false to connect to the real API Gateway
VITE_USE_MOCK=false


# Optional: Firebase Web Push client configuration (public values from Firebase Console)
# Leave empty if Web Push is not enabled; in-app notifications still work normally.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
