# ==============================================================================
# SwiftletCare — Standalone Web Environment Template
# Copy to .env.standalone and replace all placeholder values before starting.
# NEVER commit .env.standalone or real credentials to version control.
# Tip: Use hex/alphanumeric passwords (e.g. `openssl rand -hex 16`) so they are
#      URL-safe inside PostgreSQL and Redis connection strings.
# ==============================================================================

# 1. Runtime Mode & Host Ports (isolated defaults to avoid port collisions)
ENVIRONMENT=standalone
STANDALONE_FRONTEND_PORT=13000
STANDALONE_GATEWAY_PORT=18000
STANDALONE_MANAGEMENT_PORT=18001
STANDALONE_POSTGRES_PORT=15432
STANDALONE_REDIS_PORT=16379

# 2. PostgreSQL (Standalone Management Database)
POSTGRES_USER=swiftlet_standalone
POSTGRES_PASSWORD=replace_with_url_safe_random_pg_password
POSTGRES_DB=swiftletcare_standalone

# 3. Redis (Gateway Token Revocation & Cache)
REDIS_PASSWORD=replace_with_url_safe_random_redis_password

# 4. Authentication & Internal Service Security
# JWT_SECRET must be at least 32 characters; INTERNAL_SERVICE_TOKEN at least 32 hex chars.
JWT_SECRET=replace_with_random_jwt_secret_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERNAL_SERVICE_TOKEN=replace_with_random_internal_service_token_64_hex_chars

# 5. CORS Allowed Origins (match STANDALONE_FRONTEND_PORT)
ALLOWED_ORIGINS=http://localhost:13000,http://127.0.0.1:13000
