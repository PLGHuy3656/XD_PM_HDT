# =============================================================================
# SwiftletCare API Gateway — Environment Configuration Example (CP11)
# =============================================================================

# Gateway Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_DEBUG=false

# Upstream Service Base URLs (NO hardcoded URLs)
MANAGEMENT_SERVICE_URL=http://127.0.0.1:8001
IOT_SERVICE_URL=http://127.0.0.1:8002
AI_SERVICE_URL=http://127.0.0.1:8003
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8004
ANALYTICS_SERVICE_URL=http://127.0.0.1:8005

# Analytics Service Deployment Flag (CP11.3-R5-A: Fail-Closed)
# Default is false. When false, calls to /api/v1/analytics/* immediately return 503 SERVICE_NOT_DEPLOYED with zero upstream forwarding.
ANALYTICS_SERVICE_DEPLOYED=false

# Upstream Timeouts (Seconds)
DEFAULT_TIMEOUT_SECONDS=5.0
MANAGEMENT_TIMEOUT_SECONDS=5.0
IOT_TIMEOUT_SECONDS=5.0
AI_TIMEOUT_SECONDS=10.0
NOTIFICATION_TIMEOUT_SECONDS=5.0
ANALYTICS_TIMEOUT_SECONDS=15.0

# HTTP Client Pool Configuration
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=30.0

# Security, JWT & RBAC (CP11.3)
# JWT_SECRET is REQUIRED (minimum 16 characters). Gateway fails to start if omitted or too short.
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-16-chars
JWT_ALGORITHM=HS256
JWT_REQUIRE_ACTIVE_CHECK=true
USER_CACHE_TTL_SECONDS=0

# CORS
ALLOWED_ORIGINS=*
